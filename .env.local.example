# Copy to .env.local and fill in ONLY what isn't already shared.
# Never commit .env.local.
#
# Google credentials are NOT needed here. The scripts load the sibling
# ../mrc-marketing/.env first, which already provides them under different
# names (lib/env.ts maps the aliases):
#
#   GOOGLE_CLIENT_ID     <- GOOGLE_OAUTH_CLIENT_ID
#   GOOGLE_CLIENT_SECRET <- GOOGLE_OAUTH_CLIENT_SECRET
#   GOOGLE_REFRESH_TOKEN <- GOOGLE_ADS_REFRESH_TOKEN
#
# That last one is named for Ads but its consent covered adwords,
# analytics.readonly, tagmanager.readonly and webmasters.readonly — so it
# reads GA4 AND Search Console. Verified 2026-08-04.
#
# Anything set below overrides the shared file (Node applies the last
# --env-file listed, and .env.local is listed last).

# Ahrefs API v3 — NOT present in the shared mrc-marketing/.env.
# Only needed for competitor traffic; GSC covers our own traffic better.
AHREFS_API_TOKEN=

# Notion — READ-ONLY access to the Project Tasks database.
# Internal integration token from https://www.notion.so/my-integrations
# Requires permission to create an integration in the workspace that owns
# the task database. If you cannot create one, leave this blank — tasks can
# be populated through the Notion MCP connector instead.
NOTION_TOKEN=
