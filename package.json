{
  "name": "cavallo-seo-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build": "node --env-file-if-exists=../mrc-marketing/.env --env-file-if-exists=.env.local scripts/build.ts",
    "refresh": "node --env-file-if-exists=../mrc-marketing/.env --env-file-if-exists=.env.local scripts/refresh.ts",
    "start": "npm run refresh && npm run build && open dashboard.html"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
